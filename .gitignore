# --- secrets: never commit these -------------------------------------------
# The TISS iCal URL embeds a private token, TUWEL's embeds an authtoken, and the
# service account key is a full credential for the calendar.
#
# Only these are private. The settings themselves - courses, titles, reminders -
# are committed on purpose, in settings.toml and settings.tuwel.toml.
.secrets.toml
# Pre-split single-file configs, which carried the token inline. Kept ignored so an
# old working copy cannot leak one.
config.toml
tuwel.toml
service_account.json
credentials.json
token.json
*.bak

# --- local state -----------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/
sync.log

# Exported calendars and the pre-cleanup backup: your personal timetable, and
# large. No reason to have them in git.
*.ics
# ...but the test fixture must be in the repo, or CI has nothing to run against.
!tests/fixtures/*.ics
deleted_untagged_backup.json

# --- scratch ---------------------------------------------------------------
wftest/
cloud_test_baseline.json

# --- interface cache: fetched feeds and course pages, never worth committing ---
.cache/
